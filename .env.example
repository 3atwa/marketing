# ---- App ----------------------------------------------------------------
# Public URL where this app is reachable (used for unsubscribe links in emails)
PUBLIC_BASE_URL=http://localhost:8000
# Random string used to sign unsubscribe links. CHANGE THIS.
SECRET_KEY=change-me-to-a-long-random-string
# Protect the dashboard with a password (HTTP basic auth, any username). Recommended when deployed.
APP_PASSWORD=

# ---- Scraping -----------------------------------------------------------
# Identify your crawler honestly; some sites block generic bots.
SCRAPER_USER_AGENT=LeadForgeBot/1.0 (+https://your-site.example; contact you@your-site.example)
RESPECT_ROBOTS=true
CRAWL_CONCURRENCY=8
CRAWL_MAX_PAGES=5

# ---- Optional extra lead sources -----------------------------------------
# Google Places API (official, paid after free tier): https://console.cloud.google.com/
GOOGLE_PLACES_API_KEY=
# gosom/google-maps-scraper running in web mode (see docker-compose.yml), e.g. http://gmaps:8080
GMAPS_SCRAPER_URL=

# ---- Optional AI (target suggestions + personalised emails) -------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ---- Email sending (leave empty to use "open in mail app" links only) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_SSL=false
# Set false only for local/test relays that don't support STARTTLS
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=
FROM_NAME=Your Name
SENDER_COMPANY=Your Company
# Physical postal address - legally required in commercial email in the US (CAN-SPAM) and many other places
SENDER_POSTAL_ADDRESS=
DAILY_SEND_LIMIT=50
SEND_DELAY_SECONDS=20

# ---- Automation (follow-up sequences, auto-send, reply & bounce detection) ----
AUTOMATION_ENABLED=true
# Send queued emails automatically (respects DAILY_SEND_LIMIT and SEND_DELAY_SECONDS)
AUTO_SEND=true
# Read your inbox to detect replies and bounces and stop follow-ups automatically.
# Gmail: imap.gmail.com (use an app password). Outlook: outlook.office365.com. Zoho: imap.zoho.com
IMAP_HOST=
IMAP_PORT=993
IMAP_USE_SSL=true
# Default to SMTP_USER / SMTP_PASSWORD when empty
IMAP_USER=
IMAP_PASSWORD=

# ---- Audit report page (the free "website check" link you send to leads) ----
# Your booking link (Calendly, Cal.com, Google Calendar...) shown on reports and usable as {{calendar_url}}
CALENDAR_URL=
# Your WhatsApp number in international format, shown as a "Chat on WhatsApp" button on reports
SENDER_WHATSAPP=

# ---- Integrations ----
# POSTed as JSON on lead.replied, report.viewed, lead.status_changed (Zapier, n8n, Make, Slack workflows...)
WEBHOOK_URL=
